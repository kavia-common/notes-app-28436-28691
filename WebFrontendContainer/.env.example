# Create React App environment variables for WebFrontendContainer

# Bind dev server (use 0.0.0.0 in container/preview; localhost for local)
HOST=0.0.0.0

# Allow preview/reverse-proxy hosts (only for dev/preview)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Port for CRA dev server
PORT=3000

# App mode: no-auth uses localStorage; backend mode uses API
REACT_APP_NO_AUTH=true

# Backend API base URL (used when REACT_APP_NO_AUTH=false and not using proxy)
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Use CRA proxy to / (set to true to use proxy defined in package.json)
REACT_APP_USE_PROXY=false

# Enable additional API logging in console
REACT_APP_API_DEBUG=false
