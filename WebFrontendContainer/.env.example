# WebFrontendContainer environment variables

# PUBLIC_INTERFACE
# Base URL for the backend API. During local dev you can leave this unset to use CRA proxy (port 3001).
# Example for direct calls without proxy:
# REACT_APP_API_BASE_URL=http://localhost:3001/api/v1
REACT_APP_API_BASE_URL=

# PUBLIC_INTERFACE
# Enable verbose API logs in the browser console ("true" to enable)
REACT_APP_API_DEBUG=false
