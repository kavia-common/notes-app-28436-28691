# ============================================
# Frontend Environment Configuration
# ============================================

# ============================================
# NO-AUTH MODE (NEW)
# ============================================
# Enable no-auth mode to run the app without backend authentication
# When enabled, notes are stored in localStorage and summarization
# uses simple client-side heuristics
REACT_APP_NO_AUTH=true

# ============================================
# API Configuration (not used in no-auth mode)
# ============================================
# Backend API base URL (must include /api/v1 path)
# For local development: http://localhost:3001/api/v1
# For preview: https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3001/api/v1
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Enable proxy mode (alternative to absolute URL)
# When true, uses empty baseURL and CRA dev server proxies to backend
# REACT_APP_USE_PROXY=false

# Enable verbose API logging
REACT_APP_API_DEBUG=false

# ============================================
# Preview/Container Environment
# ============================================
# Bind to all interfaces (required for container environments)
HOST=0.0.0.0

# Allow access via preview domains (development only)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Enable/disable hot module replacement
FAST_REFRESH=true
