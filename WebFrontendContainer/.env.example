# WebFrontendContainer environment example
# Copy this file to ".env" and adjust as needed.

# The backend base URL for API requests.
# Use a working backend or keep default for local dev.
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Enable extra API request/response logging in development (true/false)
REACT_APP_API_DEBUG=false

# Host/Port for CRA dev server (preview system expects 0.0.0.0:3000)
HOST=0.0.0.0
PORT=3000
