# Web Frontend Container (.env.example)
# Copy this file to .env and edit values accordingly.

# Base URL of backend API. MUST include /api/v1 at the end.
# Examples:
#   http://localhost:8000/api/v1
#   https://api.notesapp.com/api/v1
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Enable verbose API request/response logging and in-app diagnostics to console.
REACT_APP_API_DEBUG=false
