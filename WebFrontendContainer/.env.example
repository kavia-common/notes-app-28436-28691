# Environment variables for WebFrontendContainer
# Copy this file to .env and adjust values as needed.

# Toggle no-auth local demo mode (uses localStorage, no backend required)
# Recommended for quick start and CI preview environments.
REACT_APP_NO_AUTH=true

# Backend API base URL when using authenticated backend mode (NO_AUTH=false)
# Example: http://localhost:3001/api/v1
# If empty and NO_AUTH=false, the app will still start but API calls will fail gracefully with UI messages.
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Use CRA proxy (package.json "proxy") when calling backend from dev server.
# When true, axios baseURL will be empty and requests go to same-origin and be proxied.
REACT_APP_USE_PROXY=false

# Enable verbose API logging in the browser console
REACT_APP_API_DEBUG=false

# CRA dev server host binding for preview environments
# Set to 0.0.0.0 if you need access from network or preview URL.
HOST=0.0.0.0

# Allow non-localhost hosts (useful in preview/proxy environments)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Backwards compatibility: some old examples reference this, map to API base.
# Leave empty unless you have tooling relying on it.
REACT_APP_BACKEND_URL=
