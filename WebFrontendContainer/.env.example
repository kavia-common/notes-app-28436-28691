# Example environment configuration for Web Frontend

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL is the base URL of your backend API as defined by the OpenAPI spec.
# Example: http://localhost:8000/api/v1
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Optional: enable verbose axios request/response logging in development
REACT_APP_API_DEBUG=false
