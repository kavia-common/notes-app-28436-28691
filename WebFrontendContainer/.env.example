# WebFrontendContainer environment example
# These ensure the CRA dev server binds to the expected interface/port for previews
HOST=0.0.0.0
PORT=3002

# Allow preview/custom hostnames (optional; CRA only)
# DANGEROUSLY_DISABLE_HOST_CHECK=true

# App configuration
# Enable no-auth mode for local/preview use (no backend needed)
REACT_APP_NO_AUTH=true

# Backend mode configuration (when REACT_APP_NO_AUTH=false)
# REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# Optional debugging
# REACT_APP_API_DEBUG=false
