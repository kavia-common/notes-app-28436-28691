# Sample environment for WebFrontendContainer (CRA)

# ============================================================================
# API CONFIGURATION - REQUIRED
# ============================================================================

# API base URL - REQUIRED for proper backend communication
# 
# LOCAL DEVELOPMENT (with backend on port 3001):
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# PREVIEW ENVIRONMENT:
# Set to the actual backend preview URL (check running_containers for backend URL)
# Example: REACT_APP_API_BASE_URL=https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3001/api/v1
#
# PRODUCTION:
# REACT_APP_API_BASE_URL=https://your-backend-domain.com/api/v1

# ============================================================================
# PROXY MODE (Alternative to absolute URLs)
# ============================================================================

# Enable proxy mode to use same-origin relative paths (empty baseURL)
# When enabled, CRA dev server proxies API requests to backend (see package.json "proxy" field)
# This avoids CORS issues in development
# REACT_APP_USE_PROXY=true

# Note: If using proxy mode, ensure package.json has:
# "proxy": "http://localhost:3001"
# Or for preview: "proxy": "http://backend-service:3001"

# ============================================================================
# DEBUGGING
# ============================================================================

# Enable verbose API logging in dev (optional)
# Shows request/response details, resolved URLs, and network errors
# REACT_APP_API_DEBUG=true

# ============================================================================
# DEV SERVER CONFIGURATION
# ============================================================================

# Development server network binding; set to 0.0.0.0 in preview/containerized environments
# HOST=0.0.0.0

# Prevent "Invalid Host header" when accessed via a preview domain or reverse proxy
# DANGEROUSLY_DISABLE_HOST_CHECK=true

# If hot reloading misbehaves in preview environments, disable Fast Refresh
# FAST_REFRESH=false

# ============================================================================
# CONFIGURATION GUIDE
# ============================================================================

# For LOCAL development:
# 1. Use default REACT_APP_API_BASE_URL=http://localhost:3001/api/v1
# 2. Start backend on port 3001
# 3. Run: npm start

# For PREVIEW environment:
# 1. Check backend preview URL from deployment logs or running_containers
# 2. Set REACT_APP_API_BASE_URL to match backend preview (including /api/v1 path)
# 3. OR set REACT_APP_USE_PROXY=true and configure package.json proxy
# 4. Ensure HOST=0.0.0.0 and DANGEROUSLY_DISABLE_HOST_CHECK=true
# 5. Run: npm start

# For PRODUCTION:
# 1. Set REACT_APP_API_BASE_URL to production backend URL
# 2. Build: npm run build
# 3. Deploy build/ folder
# 4. Ensure backend CORS allows production frontend origin
