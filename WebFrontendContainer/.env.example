# ============================================================================
# WebFrontendContainer Environment Configuration
# ============================================================================

# This file shows all available environment variables.
# Copy to .env and update values for your environment.

# ============================================================================
# API CONFIGURATION - REQUIRED
# ============================================================================

# Backend API base URL - REQUIRED for proper backend communication
# MUST include the /api/v1 path suffix

# LOCAL DEVELOPMENT (backend on localhost:3001):
# REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# PREVIEW ENVIRONMENT (current setup):
REACT_APP_API_BASE_URL=https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3001/api/v1

# PRODUCTION:
# REACT_APP_API_BASE_URL=https://your-production-backend.com/api/v1

# ============================================================================
# CONFIGURATION MODE
# ============================================================================

# Mode 1: Absolute URL (RECOMMENDED for preview/production)
# - Uses full backend URL as shown above
# - Clear and explicit
# - Easier to troubleshoot
# - Requires proper CORS configuration on backend

# Mode 2: Proxy Mode (Alternative for local development)
# - Uncomment line below to enable
# - Uses CRA dev server proxy (see package.json "proxy" field)
# - Avoids CORS issues in development
# - Not recommended for preview environments
# REACT_APP_USE_PROXY=true

# ============================================================================
# DEBUGGING
# ============================================================================

# Enable verbose API logging (RECOMMENDED for preview/troubleshooting)
# Shows:
# - Resolved backend URL
# - All API requests with full URLs
# - Response status and data
# - Network errors with details
REACT_APP_API_DEBUG=true

# ============================================================================
# DEV SERVER CONFIGURATION (Required for Preview)
# ============================================================================

# Bind to all network interfaces (REQUIRED for preview/container access)
# Allows external connections to reach the dev server
HOST=0.0.0.0

# Disable host header checking (REQUIRED for preview domains)
# Prevents "Invalid Host header" errors when accessed via reverse proxy
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Disable Fast Refresh if hot reload causes issues (OPTIONAL)
# Uncomment if experiencing hot reload loops in preview
# FAST_REFRESH=false

# ============================================================================
# QUICK START GUIDES
# ============================================================================

# FOR LOCAL DEVELOPMENT:
# 1. Copy this file: cp .env.example .env
# 2. Set: REACT_APP_API_BASE_URL=http://localhost:3001/api/v1
# 3. Start backend on port 3001
# 4. Run: npm start
# 5. Open: http://localhost:3000

# FOR PREVIEW ENVIRONMENT (Current):
# 1. Configuration is already set above (preview URLs)
# 2. Ensure backend is running at: https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3001
# 3. Verify CORS allows: https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3000
# 4. Run: npm start
# 5. Open: https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3000
# 6. If backend unavailable, you'll see clear error message with troubleshooting

# FOR PRODUCTION:
# 1. Set REACT_APP_API_BASE_URL to production backend URL
# 2. Set REACT_APP_API_DEBUG=false
# 3. Build: npm run build
# 4. Deploy build/ folder
# 5. Ensure backend CORS allows production frontend origin

# ============================================================================
# VERIFICATION
# ============================================================================

# Run configuration verification:
# node verify-config.js

# Test backend connectivity:
# npm run verify

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# Cannot reach backend?
# - Check backend is running: curl https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3001/health
# - Verify REACT_APP_API_BASE_URL is correct
# - Enable debug logging: REACT_APP_API_DEBUG=true
# - Check browser console for detailed errors
# - Frontend will show clear error with troubleshooting steps

# CORS errors?
# - Backend must allow origin: https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3000
# - Check backend CORS middleware configuration
# - See PREVIEW-CONFIG-GUIDE.md for details

# For complete guides, see:
# - README.md - General setup
# - PREVIEW-CONFIG-GUIDE.md - Preview environment configuration
# - INTEGRATION-CHECKLIST.md - Verification steps
# - CHANGES.md - All integration changes
