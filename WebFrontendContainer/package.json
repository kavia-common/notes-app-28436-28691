{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "dependencies": {
    "axios": "^1.12.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "PORT=3000 react-scripts start",
    "start:noauth": "REACT_APP_NO_AUTH=true PORT=3000 react-scripts start",
    "start:backend": "REACT_APP_NO_AUTH=false PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "build:noauth": "REACT_APP_NO_AUTH=true react-scripts build",
    "build:prod": "REACT_APP_API_BASE_URL=$BACKEND_URL react-scripts build",
    "test": "CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "lint": "eslint . --ext .js,.jsx --max-warnings=0 || true",
    "verify": "node verify-backend.js",
    "verify:bash": "bash test-api-connection.sh",
    "verify:config": "node verify-config.js",
    "clean": "rm -rf node_modules build package-lock.json",
    "reinstall": "npm run clean && npm install --legacy-peer-deps"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-router-dom": "^5.3.3",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.3"
  }
}
