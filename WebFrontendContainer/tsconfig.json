{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "ES2020"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "node",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    },
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["react", "react-dom", "jest", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/react-app-env.d.ts"],
  "exclude": ["node_modules", "public", "**/*.js", "**/*.jsx", "jest.config.js", "babel.config.js", "eslint.config.mjs"]
}
