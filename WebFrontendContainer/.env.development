# Development-only settings for CRA dev server to work in preview environments

# Bind to all interfaces so the container is reachable externally (platform maps port 3000)
HOST=0.0.0.0

# Disable strict host checking to prevent "Invalid Host header" on preview domains
DANGEROUSLY_DISABLE_HOST_CHECK=true

# In some CI/preview setups, Fast Refresh websocket can misbehave; disable if hot reload loops occur
# Uncomment if needed:
# FAST_REFRESH=false
