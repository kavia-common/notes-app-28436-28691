# Development-only settings for CRA dev server to work in preview environments

# Bind to all interfaces so the container is reachable externally (platform maps port 3000)
HOST=0.0.0.0

# Disable strict host checking to prevent "Invalid Host header" on preview domains
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Enable API debug logging to troubleshoot preview connectivity issues
# Uncomment to see detailed request/response logs:
# REACT_APP_API_DEBUG=true

# For preview environments, you may need to set the backend URL explicitly:
# Check the backend preview URL and uncomment/update:
# REACT_APP_API_BASE_URL=https://vscode-internal-14543-qa.qa01.cloud.kavia.ai:3001/api/v1

# OR enable proxy mode if backend is accessible via same domain:
# REACT_APP_USE_PROXY=true

# In some CI/preview setups, Fast Refresh websocket can misbehave; disable if hot reload loops occur
# Uncomment if needed:
# FAST_REFRESH=false
